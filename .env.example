# Copy to .env. Choose the actual HTTPS hostname; never commit credentials.
SGANCIA_PUBLIC_ORIGIN=https://sgancia.example.org
SGANCIA_SECURE_COOKIES=true
SGANCIA_SESSION_HOURS=24
# Generate: python -m app.cli encryption-key (in backend environment).
SGANCIA_ENCRYPTION_KEY=
# Generate a distinct long random database password.
POSTGRES_PASSWORD=
# Explicitly trusted proxy IPs/networks only. Never use * on exposed networks.
SGANCIA_TRUSTED_PROXIES=127.0.0.1

# Separate backup encryption key; generate via python -m app.backup key.
# Keep a recovery copy outside the server and do not lose the application encryption key.
SGANCIA_BACKUP_KEY=

# Mac: loopback only. Server: set the private LAN IP (or 0.0.0.0 if appropriate).
SGANCIA_BIND_IP=127.0.0.1
SGANCIA_PORT=8088
# Other exact entry points, including both local aliases; keep Secure cookies true on the server.
# SGANCIA_ALLOWED_ORIGINS=["https://192.168.1.20:8088","https://sgancia.example.org"]
SGANCIA_ALLOWED_ORIGINS=["http://localhost:8088","http://127.0.0.1:8088"]
# Optional explicit HTTP LAN exception, requested by the user. Use actual private server IP.
# SGANCIA_HTTP_LAN_ORIGINS=["http://192.168.1.20:8088"]
SGANCIA_HTTP_LAN_ORIGINS=[]
# HTTPS domain always retains Secure cookies, independently of HTTP LAN.
# LAN HTTPS without Nginx: see docker-compose.tls.yml.example.

# Private attachments: bytes per file, quota per account in each group, active files per expense/receipt.
SGANCIA_ATTACHMENT_MAX_BYTES=10485760
SGANCIA_ATTACHMENT_GROUP_BYTES=104857600
SGANCIA_ATTACHMENT_MAX_COUNT=20

# Optional email delivery: STARTTLS (587) or SSL (465), no mandatory provider.
# Set the public origin to the real address used in email links.
SGANCIA_SMTP_HOST=
SGANCIA_SMTP_PORT=587
SGANCIA_SMTP_MODE=starttls
SGANCIA_SMTP_USERNAME=
SGANCIA_SMTP_PASSWORD=
SGANCIA_SMTP_SENDER=
